# DATABASE_URL
# Pooled application connection (Neon pooled endpoint -pooled).
# Used by the Next.js app at runtime. Leave blank until Step03.
# Example: postgresql://user:password@host-pooler/neondb?sslmode=require
DATABASE_URL=

# MIGRATION_DATABASE_URL
# Optional direct/session-capable connection used only by db/migrations.js.
# For Neon, use the direct (non-pooled) endpoint so the transaction-level
# advisory migration lock is honored. If unset, migrations fall back to DATABASE_URL.
# Leave blank unless your pooled endpoint does not support session-level locks.
# Example: postgresql://user:password@host/neondb?sslmode=require
MIGRATION_DATABASE_URL=

# SESSION_SECRET
# Iron-session cookie seal password. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
# Used to seal the opaque session id cookie. Never commit the real value.
SESSION_SECRET=

# TRUSTED_ORIGIN
# Canonical origin for the deployed application (e.g. https://app.example.com).
# Required in production for logout POST origin/CSRF enforcement and safe
# non-localhost logout redirect. Without it, logout rejects all POSTs and
# redirects to the relative /login path.
TRUSTED_ORIGIN=

# TRUSTED_ORIGIN_DEV
# Optional dev override for the trusted origin (e.g. http://localhost:3000).
# If unset, TRUSTED_ORIGIN is used in all environments.
TRUSTED_ORIGIN_DEV=